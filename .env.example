# Where the SQLite file lives. Defaults to ./.data/provenance.db.
# The app falls back to an in-memory store when the filesystem is not writable
# (typical for a preview deployment) and reports the choice on /api/status.
# PROVENANCE_DB_PATH=/var/data/provenance.db

# Absolute origin used in anchors, exports and share links. Set this in production.
# PROVENANCE_ORIGIN=https://your-app.vercel.app
