# Where the SQLite file lives. Defaults to ./.data/provenance.db.
# On a host with a disk, point this at a mounted volume for durable records.
# On a serverless platform (Vercel, Lambda) the store is in-memory by default —
# data resets on cold start — and /api/status reports that plainly.
# PROVENANCE_DB_PATH=/data/provenance.db

# Set to 1 to force a disk-backed store even where a serverless platform is
# detected (only useful if PROVENANCE_DB_PATH points at a real writable volume).
# PROVENANCE_FORCE_DISK=1

# Absolute origin used in anchors, exports and share links. Set this in production.
# PROVENANCE_ORIGIN=https://your-app.vercel.app
